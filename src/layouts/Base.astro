---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "@fontsource/caveat/500.css";
import "../styles/global.css";
import Icon from "../components/Icon.astro";

interface Props { title?: string; description?: string; wide?: boolean; noindex?: boolean }
const { title, description = "Linda’s Kitchen — the Linda M Cookbook: our favourite family recipes, all in one place.", noindex = true } = Astro.props;
const fullTitle = title ? `${title} · Linda’s Kitchen` : "Linda’s Kitchen";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const nav = [
  { href: "/", label: "Home", icon: "home", match: (p: string) => p === "/" },
  { href: "/recipes", label: "Recipes", icon: "book", match: (p: string) => p.startsWith("/recipes") || p.startsWith("/chapters") },
  { href: "/linda", label: "Linda", icon: "user", match: (p: string) => p.startsWith("/linda") },
  { href: "/search", label: "Search", icon: "search", match: (p: string) => p.startsWith("/search") },
  { href: "/saved", label: "Saved", icon: "heart", match: (p: string) => p.startsWith("/saved") || p.startsWith("/passport") },
];
const extra = [
  { href: "/occasions", label: "Occasions", match: (p: string) => p.startsWith("/occasions") || p.startsWith("/menu") },
  { href: "/family", label: "Family Table", match: (p: string) => p.startsWith("/family") },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#fbf6ec" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script is:inline>
      // Festive palette in December (or ?festive=1 to preview it)
      (function () {
        var d = new Date();
        var q = new URLSearchParams(location.search).get("festive");
        if ((d.getMonth() === 11 && q !== "0") || q === "1") document.documentElement.classList.add("festive");
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="pb-[calc(5rem+env(safe-area-inset-bottom))] md:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] btn btn-primary">Skip to content</a>

    <header class="site-header sticky top-0 z-40 bg-paper/90 backdrop-blur border-b border-line">
      <div class="container-page flex items-center gap-4 h-16">
        <a href="/" class="flex items-center gap-2 no-underline mr-auto" aria-label="Linda’s Kitchen home">
          <img src="/favicon.svg" alt="" width="34" height="34" class="rounded-full" />
          <span class="font-serif text-xl sm:text-2xl font-semibold tracking-tight">Linda’s Kitchen</span>
        </a>
        <nav aria-label="Main" class="hidden md:flex items-center gap-1">
          {[...nav.slice(1, 3), ...extra].map((n) => (
            <a href={n.href} class:list={["px-3 py-2 rounded-full no-underline font-medium hover:bg-paper-2", n.match(path) && "bg-paper-2 text-tomato"]} aria-current={n.match(path) ? "page" : undefined}>{n.label}</a>
          ))}
          <a href="/search" class="p-2.5 rounded-full hover:bg-paper-2" aria-label="Search"><Icon name="search" /></a>
          <a href="/saved" class="p-2.5 rounded-full hover:bg-paper-2 relative" aria-label="Saved recipes">
            <Icon name="heart" /><span data-fav-count class="absolute -top-0.5 -right-0.5 min-w-5 h-5 px-1 rounded-full bg-tomato text-white text-xs font-bold grid place-items-center" hidden></span>
          </a>
        </nav>
        <a href="/occasions" class="md:hidden chip !min-h-[40px] !px-3 text-sm">Occasions</a>
      </div>
    </header>

    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>

    <footer class="site-footer mt-16 border-t border-line bg-paper-2/60">
      <div class="container-page py-10 grid gap-6 sm:grid-cols-3 text-ink-soft">
        <div>
          <p class="font-serif text-xl text-ink font-semibold">Linda’s Kitchen</p>
          <p class="mt-1 text-sm">The Linda M Cookbook — our favourite recipes, all in one place. A family draft, still being finished together.</p>
        </div>
        <ul class="text-sm space-y-1">
          <li><a href="/occasions" class="hover:text-tomato">Occasions & menus</a></li>
          <li><a href="/family" class="hover:text-tomato">The Family Table</a></li>
          <li><a href="/family/help" class="hover:text-tomato">Help finish the book</a></li>
          <li><a href="/family/photos" class="hover:text-tomato">Family photo wall</a></li>
        </ul>
        <ul class="text-sm space-y-1">
          <li><a href="/spin" class="hover:text-tomato">What should we make?</a></li>
          <li><a href="/fridge" class="hover:text-tomato">Fridge Raid</a></li>
          <li><a href="/menu" class="hover:text-tomato">Menu Builder</a></li>
          <li><a href="/passport" class="hover:text-tomato">My recipe passport</a></li>
          <li><a href="/ask" class="hover:text-tomato">Ask Linda’s Kitchen</a></li>
        </ul>
      </div>
    </footer>

    <!-- Running timers, shared across pages -->
    <section id="timer-tray" class="timer-tray fixed z-[60] right-3 left-3 md:left-auto md:w-96 bottom-[calc(5.25rem+env(safe-area-inset-bottom))] md:bottom-4" aria-label="Kitchen timers" hidden>
      <ul data-timer-list class="space-y-2 drop-shadow-xl"></ul>
    </section>
    <p id="timer-live" class="sr-only" aria-live="assertive"></p>

    <nav class="bottom-nav md:hidden fixed bottom-0 inset-x-0 z-50 bg-card/95 backdrop-blur border-t border-line pb-[env(safe-area-inset-bottom)]" aria-label="Main">
      <ul class="grid grid-cols-5">
        {nav.map((n) => (
          <li>
            <a href={n.href} class:list={["flex flex-col items-center justify-center gap-0.5 h-16 no-underline text-[.78rem] font-semibold relative", n.match(path) ? "text-tomato" : "text-ink-soft"]} aria-current={n.match(path) ? "page" : undefined}>
              <Icon name={n.icon} size={24} />
              {n.label}
              {n.icon === "heart" && <span data-fav-count class="absolute top-2 right-[calc(50%-1.4rem)] min-w-5 h-5 px-1 rounded-full bg-tomato text-white text-[.7rem] font-bold grid place-items-center" hidden></span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <script>
      import { favs, toast } from "../scripts/store";
      import { initTimers } from "../scripts/timers";

      function paintFavs() {
        const list = favs.all();
        document.querySelectorAll<HTMLButtonElement>("[data-fav]").forEach((b) => {
          const on = list.includes(b.dataset.fav!);
          b.setAttribute("aria-pressed", String(on));
          const svg = b.querySelector("svg");
          if (svg) svg.setAttribute("fill", on ? "currentColor" : "none");
        });
        document.querySelectorAll<HTMLElement>("[data-fav-count]").forEach((el) => {
          el.textContent = String(list.length);
          el.hidden = list.length === 0;
        });
      }
      document.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-fav]");
        if (!b) return;
        e.preventDefault();
        e.stopPropagation();
        const on = favs.toggle(b.dataset.fav!);
        paintFavs();
        toast(on ? "Saved to your recipes ♥" : "Removed from saved");
      });
      window.addEventListener("lk:store", paintFavs);
      paintFavs();
      initTimers();
    </script>
  </body>
</html>
