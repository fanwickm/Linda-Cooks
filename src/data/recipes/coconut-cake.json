  "steps": [
    {
      "lead": "Heat the oven.",
      "text": "Heat the oven to 350°F. Grease and flour three 8-inch layer pans; a circle of parchment in the bottom makes them easy to turn out."
    },
    {
      "lead": "Cream.",
      "text": "Cream the sugar, Crisco, and butter together until light and fluffy, about 4 minutes."
    },
    {
      "lead": "Add the eggs.",
      "text": "Add the eggs one at a time, beating well after each."
    },
    {
      "lead": "Soda into the buttermilk.",
      "text": "Stir the baking soda into the buttermilk."
    },
    {
      "lead": "Alternate.",
      "text": "On low speed, add the flour alternately with the buttermilk, beginning and ending with flour, mixing just until smooth."
    },
    {
      "lead": "Fold in the coconut.",
      "text": "Fold in the coconut by hand."
    },
    {
      "lead": "Bake.",
      "text": "Divide among the pans and bake about 30 minutes, until golden and a toothpick in the center comes out clean. Cool 10 minutes in the pans, then turn out and cool completely."
    },
    {
      "lead": "Frost.",
      "text": "Beat the butter, confectioners’ sugar, cream, and vanilla until smooth and spreadable. Fill and frost the layers, then cover the cake with chopped walnuts."
    }
  ],
  "notes": [
    {
      "label": "Cream cheese frosting (the blue-pen note)",
      "text": "1 pound cream cheese, 2 sticks butter, 1 pound confectioners’ sugar, and vanilla and almond extract to taste, beaten smooth. It makes a generous batch.",
      "byLinda": false
    },
    {
      "label": "No salt on the card",
      "text": "with unsalted butter, add ½ teaspoon salt to the flour; most versions of this cake include it.",
      "byLinda": false
    },
    {
      "label": "Margarine or butter",
      "text": "the card allows either. Butter tastes better; margarine gives a slightly softer crumb.",
      "byLinda": false
    },
    {
      "label": "Ahead of time",
      "text": "bake the layers a day ahead and wrap tightly. The frosted cake keeps 3 days refrigerated.",
      "byLinda": false
    }
