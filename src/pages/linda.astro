---
import Base from "../layouts/Base.astro";
import RecipeCard from "../components/RecipeCard.astro";
import LindaBadge from "../components/LindaBadge.astro";
import linda from "../data/linda.json";
import { lindaRecipes, lindaQuotes, getRecipe, LINDA } from "../lib/data";

const all = lindaRecipes();
const quotes = lindaQuotes();
---
<Base title="Meet Linda" description="Linda Mitchell — the hostess and the heart of the Linda M Cookbook.">
  <section class="container-page pt-6 sm:pt-12 grid md:grid-cols-[1fr_1.2fr] gap-8 md:gap-14 items-center">
    <div class="relative mx-auto w-[72%] max-w-xs md:max-w-[24rem] md:w-full">
      <img src="/images/people/linda.jpg" alt="Linda Mitchell, smiling, in a family portrait" width="880" height="1056" class="w-full aspect-[5/6] object-cover object-[50%_20%] rounded-t-[999px] ring-1 ring-ink/15 ring-offset-[6px] ring-offset-paper" fetchpriority="high" />
    </div>
    <div>
      <p class="eyebrow">The hostess · the heart of the book</p>
      <h1 class="text-5xl sm:text-6xl font-semibold mt-2">Meet Linda</h1>
      <p class="mt-2 font-serif text-2xl italic text-ink-soft">{linda.fullName}</p>
      {linda.story.length > 0 ? (
        <div class="mt-5 space-y-4 text-lg leading-relaxed">
          {linda.story.map((p: string) => <p>{p}</p>)}
          {linda.storyAuthor && <p class="text-ink-soft">— {linda.storyAuthor}</p>}
        </div>
      ) : (
        <div class="mt-6 rounded-2xl border-2 border-dashed border-line p-5 bg-card/60">
          <p class="font-semibold">Linda’s story is being written by the family.</p>
          <p class="mt-1 text-ink-soft">How she learned to cook, the Christmas Eves, the table that always has room for one more — coming soon. <a href="/family/help#linda" class="text-tomato underline">Want to help write it?</a></p>
        </div>
      )}
    </div>
  </section>

  <div class="container-page mt-14 space-y-16">
    <!-- photo strip -->
    <section aria-labelledby="ph-h">
      <h2 id="ph-h" class="text-3xl font-semibold">Photos</h2>
      <div class="mt-5 -mx-4 px-4 flex gap-5 overflow-x-auto snap-x scroll-px-4 pb-4">
        {linda.photos.map((p: any, i: number) => (
          <figure class:list={["snap-start shrink-0 bg-card p-3 pb-2 shadow-md", p.wide ? "w-[85vw] max-w-[40rem]" : "w-64 sm:w-80", i % 2 ? "rotate-[1deg]" : "rotate-[-1deg]"]}>
            <img src={p.src} alt={p.alt} class:list={["w-full object-cover", p.wide ? "h-80 sm:h-[25rem] object-[50%_30%]" : "aspect-[4/5]"]} loading="lazy" />
            <figcaption class="font-hand text-2xl text-center mt-1">{p.caption}</figcaption>
          </figure>
        ))}
        {[1, 2].map(() => (
          <div class="snap-start shrink-0 w-64 sm:w-80 bg-card/60 border-2 border-dashed border-line p-3 grid place-items-center text-center text-ink-soft aspect-[4/5]">
            <p>A photo of Linda in the kitchen?<br /><a href="/family/photos" class="text-tomato underline">Send one in</a></p>
          </div>
        ))}
      </div>
    </section>

    <!-- her words -->
    {quotes.length > 0 && (
      <section aria-labelledby="words-h">
        <h2 id="words-h" class="text-3xl font-semibold">In her own hand</h2>
        <p class="mt-1 text-ink-soft">Linda’s notes from her copy of the first draft.</p>
        <div class="mt-8 grid gap-10 sm:grid-cols-2 max-w-3xl">
          {quotes.map(({ recipe, quote }) => (
            <figure class="sticky-note">
              <blockquote>“{quote.text}”</blockquote>
              <figcaption class="by">on <a href={`/recipes/${recipe.slug}`} class="underline">{recipe.title.replace("Linda’s ", "")}</a></figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- kitchen rules -->
    <section aria-labelledby="rules-h" class="relative">
      <div class="max-w-3xl mx-auto border-y border-ink py-10 sm:py-14 text-center sm:text-left">
        <p class="eyebrow">Pulled from her notes in the book</p>
        <h2 id="rules-h" class="text-4xl sm:text-5xl mt-2">Linda’s Kitchen Rules</h2>
        <ol class="mt-8 space-y-5 list-decimal pl-8 text-left marker:font-serif marker:italic marker:text-gold marker:text-2xl font-serif text-xl leading-snug">
          {linda.kitchenRules.map((k: any) => (
            <li>{k.rule} <a href={`/recipes/${k.recipe}`} class="block mt-1 font-sans text-[.7rem] font-semibold tracking-[.16em] uppercase text-tomato no-underline hover:underline">{getRecipe(k.recipe).title.replace("Linda’s ", "")} →</a></li>
          ))}
        </ol>
      </div>
    </section>

    <!-- favourites -->
    <section aria-labelledby="fav-h">
      <h2 id="fav-h" class="text-3xl font-semibold">Linda’s local favourites</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        {linda.favourites.map((f: any) => (
          <a href={`/recipes/${f.recipe}`} class="card card-lift p-5 no-underline">
            <p class="font-serif text-xl">{f.name}</p>
            <p class="mt-1 text-ink-soft">{f.note}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- every recipe -->
    <section aria-labelledby="all-h">
      <div class="flex flex-wrap items-center gap-3"><LindaBadge /></div>
      <h2 id="all-h" class="text-3xl font-semibold mt-2">Every recipe Linda made or annotated</h2>
      <div class="mt-5 grid gap-4 grid-cols-2 lg:grid-cols-4">
        {all.map((r) => <RecipeCard recipe={r} />)}
      </div>
    </section>
  </div>
</Base>
