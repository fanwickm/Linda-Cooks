  "steps": [
    {
      "lead": "Heat the oven.",
      "text": "Set it to 350°F. Butter two 9-inch round cake pans, line the bottoms with parchment, and dust with cocoa."
    },
    {
      "lead": "Mix the batter.",
      "text": "Whisk the flour, sugar, cocoa, baking powder, baking soda, and salt in a large bowl. Add the eggs, milk, oil, and vanilla and beat on medium for 2 minutes. Stir in the hot coffee — the batter will be very thin. That is correct."
    },
    {
      "lead": "Bake.",
      "text": "Divide between the pans and bake 30 to 35 minutes, until a toothpick in the center comes out clean. Cool 10 minutes in the pans, then turn out onto a rack and cool completely."
    },
    {
      "lead": "Make the buttercream.",
      "text": "Beat the butter until creamy, then beat in the Nutella. Add the powdered sugar a cup at a time, then the cream and salt, and beat on medium-high for 3 minutes until light and fluffy."
    },
    {
      "lead": "Fill.",
      "text": "Level the cake tops with a serrated knife if they domed. Set one layer on a plate, spread with about 1 cup of buttercream, and scatter half the chopped hazelnuts over it. Top with the second layer."
    },
    {
      "lead": "Frost and decorate.",
      "text": "Spread a thin coat of buttercream over the whole cake and chill 20 minutes, then frost with the rest. Press the remaining hazelnuts around the bottom edge and set the Ferrero Rocher in a ring on top."
    }
  ],
  "notes": [
    {
      "label": "Skinning hazelnuts",
      "text": "toast them at 350°F for 10 to 12 minutes, then rub them in a kitchen towel while hot. Most of the skins will flake off; the rest are fine.",
      "byLinda": false
    },
    {
      "label": "Ganache drip",
      "text": "for a fancier finish, heat ½ cup cream until steaming, pour over 4 ounces chopped chocolate, stir smooth, cool until thick, and spoon over the top edge of the chilled cake before adding the chocolates.",
      "byLinda": false
    },
    {
      "label": "Ahead of time",
      "text": "bake the layers a day ahead and wrap tightly. The finished cake keeps 3 days refrigerated; serve at room temperature.",
      "byLinda": false
    }
  ],
