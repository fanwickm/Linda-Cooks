---
// Photo slot. Shows the real photo if public/images/recipes/<slug>.jpg exists,
// otherwise a warm illustrated placeholder with the dish name.
import type { Recipe } from "../lib/data";
import art from "../data/dish-art.json";
import emojiSet from "@iconify-json/fluent-emoji-flat/icons.json";

interface Props { recipe: Recipe; size?: "sm" | "md" | "lg"; class?: string; eager?: boolean }
const { recipe, size = "md", class: cls = "", eager = false } = Astro.props;

const PALETTE: Record<string, [string, string, string]> = {
  "starters-snacks": ["#f6d9c8", "#b2372a", "#fbe9df"],
  soups: ["#f3e1b7", "#8a5a12", "#faf0d6"],
  salads: ["#dfe8d9", "#3d5a3a", "#eef4ea"],
  "sauces-dressings": ["#e9e3c9", "#5f5a1f", "#f5f2e2"],
  "pasta-dumplings-grains": ["#f5e6c4", "#8f5b1a", "#fbf2de"],
  meat: ["#efd0c8", "#7d2a1f", "#f8e5e0"],
  poultry: ["#f3dcc0", "#8a4b17", "#faeedf"],
  "fish-shellfish": ["#d6e4e8", "#2a5561", "#eaf2f4"],
  "vegetables-sides": ["#e1e8cf", "#4a5e1f", "#f0f4e5"],
  "breads-breakfast": ["#f2e0c2", "#7a4f16", "#faf0de"],
  desserts: ["#f1d8dc", "#7a2c3a", "#f9eaec"],
  "preserves-pickles-condiments": ["#e5dcef", "#4d3a6b", "#f2edf7"],
};
const [bg, fg, bg2] = PALETTE[recipe.chapter] ?? ["#eee", "#333", "#f8f8f8"];
// Illustration for the plate: Fluent Emoji (MIT, Microsoft), picked per recipe in src/data/dish-art.json.
const emojiName = (art.recipes as Record<string, string>)[recipe.slug] ?? (art.chapters as Record<string, string>)[recipe.chapter];
const emoji = (emojiSet as any).icons[emojiName];
if (!emoji) throw new Error(`dish-art.json: no illustration called "${emojiName}" (for ${recipe.slug})`);
const plate = size === "lg" ? "w-[46%] max-w-[15rem]" : size === "sm" ? "w-[52%]" : "w-[48%]";
---
{recipe.photo ? (
  <img src={recipe.photo} alt={recipe.title} class={`object-cover w-full h-full ${cls}`} loading={eager ? "eager" : "lazy"} decoding="async" />
) : (
  <div
    class={`dish-art relative w-full h-full overflow-hidden grid place-items-center ${cls}`}
    style={`--art-bg:${bg};--art-bg2:${bg2};--art-fg:${fg}`}
    role="img"
    aria-label={`${recipe.title} (illustration, photo coming soon)`}
  >
    <div class={`dish-plate ${plate}`}>
      <svg viewBox="0 0 32 32" class="w-[58%] h-[58%] drop-shadow-[0_3px_3px_rgba(60,40,20,.25)]" aria-hidden="true" set:html={emoji.body} />
    </div>
    {size === "lg" && <span class="absolute right-3 bottom-3 rounded-full bg-white/75 px-3 py-1 text-xs font-semibold tracking-wide" style={`color:${fg}`} aria-hidden="true">Photo coming soon</span>}
  </div>
)}
