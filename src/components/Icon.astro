---
interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 24, class: cls = "", label } = Astro.props;

import ph from "@iconify-json/ph/icons.json";

// Chapter icons come from Phosphor Icons (MIT). Names are chapter slugs.
const CHAPTER: Record<string, string> = {
  "starters-snacks": "cheese",
  soups: "bowl-steam",
  salads: "leaf",
  "sauces-dressings": "drop-half-bottom",
  "pasta-dumplings-grains": "fork-knife",
  meat: "knife",
  poultry: "bird",
  "fish-shellfish": "fish",
  "vegetables-sides": "carrot",
  "breads-breakfast": "bread",
  desserts: "cake",
  "preserves-pickles-condiments": "jar-label",
};
const chapterIcon = CHAPTER[name] ? (ph as any).icons[CHAPTER[name]]?.body : undefined;

// Simple line icons for the interface.
const P: Record<string, string> = {
  // ui
  home: '<path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-5h4v5"/>',
  book: '<path d="M4 4h6a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H4Z"/><path d="M20 4h-6a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h7Z"/>',
  heart: '<path d="M12 20s-8-5-8-11a4.5 4.5 0 0 1 8-3 4.5 4.5 0 0 1 8 3c0 6-8 11-8 11Z"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4-6 8-6s7 2 8 6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  users: '<circle cx="9" cy="8" r="3.5"/><path d="M2 20c1-3.5 3.5-5 7-5s6 1.5 7 5"/><circle cx="17" cy="9" r="2.5"/><path d="M17 14c2.5 0 4.2 1.4 5 4"/>',
  print: '<path d="M7 9V3h10v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v7H7z"/>',
  play: '<path d="M7 4l13 8-13 8Z"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  check: '<path d="M4 12l5 5L20 6"/>',
  chevronRight: '<path d="M9 5l7 7-7 7"/>',
  chevronLeft: '<path d="M15 5l-7 7 7 7"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  mic: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>',
  share: '<circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.2 11l7.6-4M8.2 13l7.6 4"/>',
  camera: '<path d="M4 8h3l2-3h6l2 3h3v11H4Z"/><circle cx="12" cy="13" r="3.5"/>',
  sparkle: '<path d="M12 3l2 6 6 2-6 2-2 6-2-6-6-2 6-2Z"/>',
  stamp: '<path d="M9 3h6v5l-1 3h-4L9 8Z"/><path d="M5 14h14v3H5zM7 20h10"/>',
  dice: '<rect x="4" y="4" width="16" height="16" rx="3"/><circle cx="9" cy="9" r="1.2"/><circle cx="15" cy="15" r="1.2"/><circle cx="15" cy="9" r="1.2"/><circle cx="9" cy="15" r="1.2"/>',
  fridge: '<rect x="6" y="2" width="12" height="20" rx="2"/><path d="M6 9h12M9 5v2M9 12v3"/>',
  menu: '<path d="M4 6h16M4 12h16M4 18h10"/>',
  question: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 1-1 1.7v.5M12 17h0"/>',
  chat: '<path d="M4 5h16v11H9l-5 4Z"/>',
  scale: '<path d="M12 3v18M5 7h14M5 7l-3 7a3 3 0 0 0 6 0Zm14 0-3 7a3 3 0 0 0 6 0Z"/>',
  wake: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M5 19l1.5-1.5M17.5 6.5 19 5"/>',
};
const body = P[name] ?? P.book;
---
{chapterIcon ? (
  <svg
    xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" width={size} height={size} fill="currentColor"
    class={cls} role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"}
    set:html={chapterIcon}
  />
) : (
  <svg
    xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width={size} height={size}
    fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
    class={cls} role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"}
    set:html={body}
  />
)}
