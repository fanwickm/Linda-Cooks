---
import Base from "../../layouts/Base.astro";
import RecipeCard from "../../components/RecipeCard.astro";
import Countdown from "../../components/Countdown.astro";
import { occasions, recipeBySlug, type Occasion } from "../../lib/data";

export function getStaticPaths() {
  return occasions.map((o) => ({ params: { slug: o.slug }, props: { occasion: o } }));
}
const { occasion: o } = Astro.props as { occasion: Occasion };
const COURSES = [
  ["starter", "To start"],
  ["main", "The main event"],
  ["side", "On the side"],
  ["dessert", "Something sweet"],
] as const;
const isXmasEve = o.slug === "christmas-eve";
const menuParam = encodeURIComponent(JSON.stringify(o.menu));
---
<Base title={isXmasEve ? "Christmas Eve with Linda" : o.name} description={o.intro}>
  <div class="container-page pt-6 sm:pt-10">
    <nav class="text-sm text-ink-soft mb-3" aria-label="Breadcrumb"><a href="/occasions" class="hover:text-tomato">Occasions</a></nav>
    <span class="text-6xl" aria-hidden="true">{o.emoji}</span>
    <h1 class="text-4xl sm:text-6xl font-semibold mt-2">{isXmasEve ? "Christmas Eve with Linda" : o.name}</h1>
    <p class="mt-3 text-xl font-serif italic text-ink-soft max-w-2xl">{o.intro}</p>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href={`/menu?load=${menuParam}&name=${encodeURIComponent(o.name)}`} class="btn btn-primary">📝 Make this my menu & shopping list</a>
    </div>
    {isXmasEve && <Countdown always class="mt-8" />}

    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <div class="space-y-10">
        {COURSES.map(([key, label]) => {
          const list = (o.menu[key] ?? []).map((s) => recipeBySlug.get(s)).filter(Boolean);
          return list.length > 0 && (
            <section>
              <h2 class="text-2xl sm:text-3xl font-semibold">{label}</h2>
              <div class="mt-4 grid gap-4 grid-cols-2 xl:grid-cols-3">
                {list.map((r) => <RecipeCard recipe={r!} compact />)}
              </div>
            </section>
          );
        })}
      </div>
      {o.timeline.length > 0 && (
        <aside aria-labelledby="tl-h" class="lg:sticky lg:top-20 self-start">
          <div class="card p-5 sm:p-6">
            <h2 id="tl-h" class="text-2xl font-semibold">Make-ahead timeline</h2>
            <p class="text-sm text-ink-soft mt-1">From the notes in each recipe.</p>
            <ol class="mt-5 relative border-l-2 border-sage/40 ml-2 space-y-5">
              {o.timeline.map((t) => (
                <li class="pl-5 relative">
                  <span class="absolute -left-[9px] top-1.5 size-4 rounded-full bg-sage ring-4 ring-card" aria-hidden="true"></span>
                  <p class="text-sm font-bold uppercase tracking-wide text-sage">{t.when}</p>
                  <p class="mt-0.5">{t.task} <a href={`/recipes/${t.recipe}`} class="text-tomato underline text-sm whitespace-nowrap">Recipe →</a></p>
                </li>
              ))}
            </ol>
          </div>
        </aside>
      )}
    </div>
  </div>
</Base>
