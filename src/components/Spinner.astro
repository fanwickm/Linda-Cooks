---
// "What should we make?" — a slot-machine reel of family recipes.
import { occasions } from "../lib/data";
import Icon from "./Icon.astro";
interface Props { big?: boolean }
const { big = false } = Astro.props;
---
<section class="spinner card p-5 sm:p-7 relative overflow-hidden" data-spinner aria-labelledby="spin-h">
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="eyebrow">Can’t decide?</p>
      {big
        ? <h1 id="spin-h" class="font-semibold mt-1 text-4xl">What should we make?</h1>
        : <h2 id="spin-h" class="font-semibold mt-1 text-3xl">What should we make?</h2>}
    </div>
    <Icon name="ph:dice-five" size={36} class="text-gold" />
  </div>

  <div class="mt-4 flex gap-2 flex-wrap" role="group" aria-label="Narrow it down">
    <button type="button" class="chip !border-gold" data-f="linda" aria-pressed="false">Something Linda makes</button>
    <button type="button" class="chip" data-f="quick" aria-pressed="false">Under an hour</button>
    {occasions.map((o) => <button type="button" class="chip" data-f={`o:${o.slug}`} aria-pressed="false">{o.name}</button>)}
  </div>

  <div class="mt-5 relative border border-ink bg-card h-28 sm:h-32 overflow-hidden shadow-inner">
    <div class="absolute inset-x-0 top-0 h-8 bg-gradient-to-b from-card to-transparent z-10 pointer-events-none"></div>
    <div class="absolute inset-x-0 bottom-0 h-8 bg-gradient-to-t from-card to-transparent z-10 pointer-events-none"></div>
    <ul class="reel will-change-transform" data-reel aria-hidden="true">
      <li class="h-28 sm:h-32 grid place-items-center px-4 text-center font-serif text-2xl sm:text-3xl font-semibold text-ink-soft">Pull the lever →</li>
    </ul>
  </div>
  <p class="sr-only" aria-live="polite" data-spin-live></p>

  <div class="mt-5 flex flex-wrap items-center gap-3">
    <button type="button" class="btn btn-primary !min-h-[52px] !px-9" data-spin>Spin</button>
    <a href="#" class="btn btn-ghost hidden" data-spin-go>Let’s make it →</a>
  </div>
</section>

<script>
  import { reducedMotion, link } from "../scripts/store";
  type Entry = { s: string; t: string; o: string[]; l: boolean; tb: string | null; ok: boolean };
  let data: Entry[] | null = null;
  async function getData(): Promise<Entry[]> {
    data ??= (await (await fetch(link("/search-index.json"))).json()) as Entry[];
    return data!.filter((r) => r.ok);
  }

  document.querySelectorAll<HTMLElement>("[data-spinner]").forEach((root) => {
    const reel = root.querySelector<HTMLUListElement>("[data-reel]")!;
    const go = root.querySelector<HTMLAnchorElement>("[data-spin-go]")!;
    const live = root.querySelector<HTMLElement>("[data-spin-live]")!;
    const spinBtn = root.querySelector<HTMLButtonElement>("[data-spin]")!;
    const filters = [...root.querySelectorAll<HTMLButtonElement>("[data-f]")];
    filters.forEach((b) =>
      b.addEventListener("click", () => {
        const on = b.getAttribute("aria-pressed") !== "true";
        // only one occasion at a time
        if (b.dataset.f!.startsWith("o:")) filters.filter((x) => x.dataset.f!.startsWith("o:")).forEach((x) => x.setAttribute("aria-pressed", "false"));
        b.setAttribute("aria-pressed", String(on));
      }),
    );

    spinBtn.addEventListener("click", async () => {
      const all = await getData();
      const active = filters.filter((b) => b.getAttribute("aria-pressed") === "true").map((b) => b.dataset.f!);
      let pool = all.filter((r) =>
        active.every((f) =>
          f === "linda" ? r.l : f === "quick" ? r.tb === "quick" || r.tb === "hour" : f.startsWith("o:") ? r.o.includes(f.slice(2)) : true,
        ),
      );
      if (!pool.length) {
        live.textContent = "Nothing matches all of those — try fewer filters.";
        reel.innerHTML = `<li class="h-28 sm:h-32 grid place-items-center px-4 text-center text-lg">Nothing matches all of those — try fewer filters.</li>`;
        go.classList.add("hidden");
        return;
      }
      const pick = pool[Math.floor(Math.random() * pool.length)];
      const filler = Array.from({ length: 24 }, () => pool.length > 1 ? all[Math.floor(Math.random() * all.length)] : pick);
      const items = [...filler, pick];
      const h = reel.firstElementChild?.getBoundingClientRect().height || 112;
      reel.innerHTML = items
        .map(() => `<li class="grid place-items-center px-4 text-center font-serif text-2xl sm:text-3xl font-semibold leading-tight" style="height:${h}px"></li>`)
        .join("");
      [...reel.children].forEach((li, i) => (li.textContent = items[i].t));
      spinBtn.disabled = true;
      const end = -(items.length - 1) * h;
      if (reducedMotion()) {
        reel.style.transform = `translateY(${end}px)`;
      } else {
        const anim = reel.animate([{ transform: "translateY(0)" }, { transform: `translateY(${end}px)` }], {
          duration: 2200, easing: "cubic-bezier(.12,.75,.25,1)", fill: "forwards",
        });
        await anim.finished;
        reel.style.transform = `translateY(${end}px)`;
      }
      spinBtn.disabled = false;
      spinBtn.textContent = "Spin again";
      go.href = link(`/recipes/${pick.s}`);
      go.classList.remove("hidden");
      live.textContent = `How about ${pick.t}?`;
      try { navigator.vibrate?.(40); } catch {}
    });
  });
</script>
