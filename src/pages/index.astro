---
import Base from "../layouts/Base.astro";
import RecipeCard from "../components/RecipeCard.astro";
import Icon from "../components/Icon.astro";
import Spinner from "../components/Spinner.astro";
import Countdown from "../components/Countdown.astro";
import LindaBadge from "../components/LindaBadge.astro";
import { recipes, chapters, occasions, LINDA, LINDA_SIGNATURES, getRecipe, lindaRecipes, openQuestions } from "../lib/data";

const signatures = LINDA_SIGNATURES.map(getRecipe);
const touched = lindaRecipes().filter((r) => !LINDA_SIGNATURES.includes(r.slug));
const napaQuote = getRecipe("lindas-napa-cabbage-salad").quotes[0];
const openCount = openQuestions.filter((q) => q.question).length;
---
<Base description="Linda’s Kitchen — the Linda M Cookbook. 79 family recipes, with Linda at the heart of the table.">
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="container-page pt-6 sm:pt-12 pb-8 grid md:grid-cols-[1fr_1.1fr] gap-8 md:gap-12 items-center">
      <div class="relative mx-auto w-[78%] max-w-sm md:w-full md:max-w-[26rem] md:justify-self-center">
        <div class="relative rounded-t-[999px] rounded-b-3xl overflow-hidden border-[10px] border-card shadow-[0_20px_40px_-20px_rgba(60,40,20,.5)] aspect-[5/6] bg-paper-2">
          <img src={LINDA.photo!} alt="Linda Mitchell, smiling in her kitchen" class="w-full h-full object-cover object-[50%_30%]" width="720" height="874" fetchpriority="high" />
        </div>
        <div class="absolute -bottom-5 -right-3 sm:-right-8 rotate-[-4deg]">
          <span class="linda-badge !text-2xl !px-4 !py-1.5 shadow-md bg-[#fbefd3]">♥ Linda</span>
        </div>
      </div>
      <div class="text-center md:text-left">
        <p class="eyebrow">The Linda M Cookbook</p>
        <h1 class="mt-2 text-5xl sm:text-7xl font-semibold leading-[0.95]">Linda’s<br class="hidden sm:block" /> Kitchen</h1>
        <p class="mt-4 text-xl sm:text-2xl font-serif italic text-ink-soft">Our favourite recipes, all in one place — gathered around Linda’s table.</p>
        <p class="mt-3 text-base text-ink-soft">{recipes.length} recipes · {chapters.length} chapters · one very well-loved recipe box.</p>
        <div class="mt-6 flex flex-wrap gap-3 justify-center md:justify-start">
          <a href="/recipes" class="btn btn-primary text-lg !min-h-[52px]">Open the recipe box</a>
          <a href="/linda" class="btn btn-ghost text-lg !min-h-[52px]">Meet Linda</a>
        </div>
      </div>
    </div>
  </section>

  <div class="container-page space-y-14 sm:space-y-20 mt-4">
    <Countdown />

    <!-- LINDA'S SIGNATURES -->
    <section aria-labelledby="sig-h">
      <div class="flex items-end justify-between gap-3">
        <div>
          <p class="eyebrow">Her own dishes</p>
          <h2 id="sig-h" class="text-3xl sm:text-4xl font-semibold mt-1">Linda’s Signatures</h2>
        </div>
        <a href="/recipes?linda=1" class="hidden sm:inline text-tomato font-semibold underline underline-offset-4">Everything with Linda’s Touch →</a>
      </div>
      <div class="mt-5 -mx-4 px-4 flex gap-4 overflow-x-auto snap-x scroll-px-4 snap-mandatory pb-4 [scrollbar-width:thin] md:grid md:grid-cols-3 md:overflow-visible md:mx-0 md:px-0">
        {signatures.map((r, i) => (
          <div class="snap-start shrink-0 w-[78%] sm:w-[45%] md:w-auto"><RecipeCard recipe={r} eager={i === 0} /></div>
        ))}
      </div>
      {napaQuote && (
        <figure class="sticky-note mt-4 max-w-md ml-auto mr-2">
          <blockquote>“{napaQuote.text}”</blockquote>
          <figcaption class="by">— Linda, on her Napa Cabbage Salad</figcaption>
        </figure>
      )}
    </section>

    <Spinner />

    <!-- OCCASIONS -->
    <section aria-labelledby="occ-h">
      <p class="eyebrow">Something to celebrate</p>
      <h2 id="occ-h" class="text-3xl sm:text-4xl font-semibold mt-1">Occasions & menus</h2>
      <div class="mt-5 -mx-4 px-4 flex gap-3 overflow-x-auto snap-x scroll-px-4 pb-3 sm:grid sm:grid-cols-3 lg:grid-cols-6 sm:overflow-visible sm:mx-0 sm:px-0">
        {occasions.map((o) => (
          <a href={`/occasions/${o.slug}`} class="snap-start shrink-0 w-40 sm:w-auto card card-lift p-4 no-underline flex flex-col gap-2">
            <span class="text-4xl" aria-hidden="true">{o.emoji}</span>
            <span class="font-serif text-xl font-semibold leading-tight">{o.name}</span>
            <span class="text-sm text-ink-soft line-clamp-3">{o.intro}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- LINDA'S TOUCH -->
    <section aria-labelledby="touch-h" class="rounded-3xl bg-[#fbefd3]/60 border border-[#ecd39a] p-5 sm:p-8">
      <div class="flex flex-wrap items-center gap-3"><LindaBadge /></div>
      <h2 id="touch-h" class="text-3xl font-semibold mt-3">Recipes Linda has made her own</h2>
      <p class="mt-2 text-ink-soft max-w-2xl">She likes the roast boned and tied back on, settled the pignoli cookies at 15 minutes, and seals the mint jelly jars upside down. Look for her mark.</p>
      <div class="mt-5 grid gap-4 grid-cols-2 lg:grid-cols-4">
        {touched.map((r) => <RecipeCard recipe={r} compact />)}
      </div>
    </section>

    <!-- CHAPTERS -->
    <section aria-labelledby="ch-h">
      <p class="eyebrow">The chapters</p>
      <h2 id="ch-h" class="text-3xl sm:text-4xl font-semibold mt-1">Open the recipe box</h2>
      <div class="mt-5 grid gap-3 grid-cols-2 lg:grid-cols-4">
        {chapters.map((c) => (
          <a href={`/chapters/${c.slug}`} class="card card-lift p-4 sm:p-5 no-underline flex flex-col gap-2 min-h-[9.5rem]">
            <span class="flex items-center justify-between text-tomato">
              <Icon name={c.slug} size={34} />
              <span class="font-serif text-ink-soft/60 text-lg">{String(c.number).padStart(2, "0")}</span>
            </span>
            <span class="font-serif text-xl font-semibold leading-tight">{c.title}</span>
            <span class="text-sm text-ink-soft line-clamp-2">{c.intro}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- FUN -->
    <section class="grid gap-4 sm:grid-cols-3" aria-label="More ways to cook">
      <a href="/fridge" class="card card-lift p-5 no-underline flex gap-4 items-start">
        <span class="text-4xl" aria-hidden="true">🧊</span>
        <span><span class="font-serif text-xl font-semibold block">Fridge Raid</span><span class="text-ink-soft text-sm">Pick what you’ve got, see what you can make.</span></span>
      </a>
      <a href="/menu" class="card card-lift p-5 no-underline flex gap-4 items-start">
        <span class="text-4xl" aria-hidden="true">📝</span>
        <span><span class="font-serif text-xl font-semibold block">Menu Builder</span><span class="text-ink-soft text-sm">Plan a dinner and get one shopping list to share.</span></span>
      </a>
      <a href="/family" class="card card-lift p-5 no-underline flex gap-4 items-start">
        <span class="text-4xl" aria-hidden="true">🌳</span>
        <span><span class="font-serif text-xl font-semibold block">The Family Table</span><span class="text-ink-soft text-sm">Who brought what — from Grandma to Aunt Karen.</span></span>
      </a>
    </section>

    <section class="rounded-3xl border-2 border-dashed border-tomato/40 p-6 sm:p-8 text-center">
      <p class="eyebrow">Help finish the book</p>
      <h2 class="text-3xl font-semibold mt-1">{openCount} recipes have a question only the family can answer</h2>
      <p class="mt-2 text-ink-soft">When did Linda start making the tartare? What exactly are Snick Snacks? Tell us what you know.</p>
      <a href="/family/help" class="btn btn-primary mt-5">See the questions</a>
    </section>
  </div>
</Base>
