  "steps": [
    {
      "lead": "Heat the oven.",
      "text": "Set it to 350°F. Grease a 9×5-inch loaf pan and line the bottom and long sides with parchment."
    },
    {
      "lead": "Rub the zest into the sugar.",
      "text": "In a large bowl, rub the lemon zest into the sugar with your fingertips until it is damp and fragrant. This pulls the oil out of the zest and is where most of the lemon flavor comes from."
    },
    {
      "lead": "Mix the wet ingredients.",
      "text": "Whisk the yogurt, eggs, oil, and 2 tablespoons lemon juice into the lemon sugar until smooth."
    },
    {
      "lead": "Add the dry ingredients.",
      "text": "Whisk the flour, baking powder, and salt together, then fold into the wet mixture just until no flour shows."
    },
    {
      "lead": "Bake.",
      "text": "Pour into the pan and bake 50 to 55 minutes, until golden and a toothpick in the center comes out clean. If the top browns too fast, lay a piece of foil over it."
    },
    {
      "lead": "Soak with syrup.",
      "text": "While it bakes, simmer the lemon juice and sugar until the sugar dissolves. When the cake comes out, poke holes all over the top with a skewer and slowly spoon the warm syrup over it. Cool 15 minutes in the pan, then lift out and cool completely."
    },
    {
      "lead": "Glaze.",
      "text": "Whisk the powdered sugar with enough lemon juice to make a thick, pourable glaze. Pour over the cooled cake and let set 20 minutes before slicing."
    }
  ],
  "notes": [
    {
      "label": "Bundt version",
