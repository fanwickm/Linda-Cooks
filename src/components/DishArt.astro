---
// Photo slot. Shows the real photo if public/images/recipes/<slug>.jpg exists,
// then a stand-in stock photo if there is one, otherwise a cloth-bound cover with the dish name.
import Icon from "./Icon.astro";
import { chapterBySlug, type Recipe } from "../lib/data";

interface Props { recipe: Recipe; size?: "sm" | "md" | "lg"; class?: string; eager?: boolean }
const { recipe, size = "md", class: cls = "", eager = false } = Astro.props;

// Cloth colours for the cover that stands in when there is no photo, one per chapter.
const COVER: Record<string, string> = {
  "starters-snacks": "#7b2f25",
  soups: "#8a6a2c",
  salads: "#3f5640",
  "sauces-dressings": "#5f5b2e",
  "pasta-dumplings-grains": "#96702e",
  meat: "#5a231f",
  poultry: "#7a5232",
  "fish-shellfish": "#2e4c59",
  "vegetables-sides": "#4b5a30",
  "breads-breakfast": "#6c5234",
  desserts: "#6a3041",
  "preserves-pickles-condiments": "#493d5d",
};
const cover = COVER[recipe.chapter] ?? "#3a3530";
const chapterTitle = chapterBySlug.get(recipe.chapter)?.title ?? "";
const shortTitle = recipe.title.replace(/ with .*/, "");
const titleSize = size === "lg" ? "text-3xl sm:text-4xl" : size === "sm" ? "text-base sm:text-lg" : "text-xl sm:text-2xl";
const iconSize = size === "lg" ? 40 : size === "sm" ? 22 : 28;
---
{recipe.photo ? (
  <img src={recipe.photo} alt={recipe.title} class={`object-cover w-full h-full ${cls}`} loading={eager ? "eager" : "lazy"} decoding="async" />
) : recipe.standIn ? (
  <div class={`relative w-full h-full ${cls}`}>
    <img src={recipe.standIn} alt={`Stand-in photo for ${recipe.title} (not the family's own dish)`} width="1000" height="750" class="object-cover w-full h-full grayscale" loading={eager ? "eager" : "lazy"} decoding="async" />
    {size !== "sm" && <span class="absolute right-2 bottom-2 rounded-full bg-black/60 text-white px-2.5 py-1 text-[.6rem] font-semibold tracking-[.18em] uppercase" aria-hidden="true">Stand-in photo</span>}
  </div>
) : (
  <div
    class={`dish-cover relative w-full h-full overflow-hidden flex flex-col items-center justify-center text-center gap-2 px-6 py-5 ${cls}`}
    style={`--cover:${cover}`}
    role="img"
    aria-label={`${recipe.title} (no photo yet)`}
  >
    <Icon name={recipe.chapter} size={iconSize} class="opacity-80" />
    <span class={`cover-title ${titleSize}`} aria-hidden="true">{shortTitle}</span>
    {size !== "sm" && <span class="cover-label" aria-hidden="true">{chapterTitle}</span>}
  </div>
)}
